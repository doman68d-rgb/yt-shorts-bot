# ─────────────────────────────────────────────────────────────────────────────
# ОБЯЗАТЕЛЬНОЕ
# ─────────────────────────────────────────────────────────────────────────────
BOT_TOKEN=123456789:AAH-your-token-from-botfather-here

# ─────────────────────────────────────────────────────────────────────────────
# LLM (опционально — нужна только для «умной» стратегии)
# ─────────────────────────────────────────────────────────────────────────────
# OpenAI:
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# Или алиас через LLM_API_KEY (можно использовать, если хочешь разделить):
# LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# Провайдер по умолчанию: https://api.openai.com/v1
# OpenRouter: https://openrouter.ai/api/v1
# Ollama (локально): http://localhost:11434/v1
# LLM_BASE_URL=https://openrouter.ai/api/v1

# Модель:
# gpt-4o-mini     — дешёвая и быстрая (рекомендуется)
# gpt-4o          — умнее, но дороже
# claude-3-haiku  — через OpenRouter
# llama3.1:8b     — через Ollama
# LLM_MODEL=gpt-4o-mini

# Тонкая настройка:
# LLM_CHUNK_SECONDS=30
# LLM_MAX_TRANSCRIPT_CHARS=15000
# LLM_TIMEOUT=60

# ─────────────────────────────────────────────────────────────────────────────
# WHISPER (распознавание речи)
# ─────────────────────────────────────────────────────────────────────────────
# WHISPER_MODEL=base           # tiny / base / small / medium
# WHISPER_DEVICE=cpu           # cpu / cuda
# WHISPER_COMPUTE_TYPE=int8    # int8 — самый быстрый, базовое качество

# ─────────────────────────────────────────────────────────────────────────────
# КЛИПЫ (дефолты, переопределяются через /clips в Telegram)
# ─────────────────────────────────────────────────────────────────────────────
# CLIP_WIDTH=1080
# CLIP_HEIGHT=1920
# CLIP_DURATION=45
# CLIP_COUNT=3
# SKIP_EDGES_PERCENT=10

# ─────────────────────────────────────────────────────────────────────────────
# ПУТИ (опционально — по умолчанию downloads/ и clips/ в корне проекта)
# ─────────────────────────────────────────────────────────────────────────────
# DOWNLOADS_DIR=downloads
# CLIPS_DIR=clips
